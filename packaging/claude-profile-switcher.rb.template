# Generated by scripts/package-release.sh. Edit packaging/claude-profile-switcher.rb.template instead.
cask "claude-profile-switcher" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/onlyilkr/claude-profile-switcher/releases/download/v#{version}/Claude-Profile-Switcher-#{version}.zip"
  name "Claude Profile Switcher"
  desc "Run several Claude desktop accounts side by side from the menu bar (unofficial)"
  homepage "https://github.com/onlyilkr/claude-profile-switcher"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :ventura

  app "Claude Profile Switcher.app"
  binary "#{appdir}/Claude Profile Switcher.app/Contents/MacOS/ClaudeProfileSwitcher", target: "claude-profiles"

  # The app is ad-hoc signed, not notarized, so the quarantine flag is cleared after
  # install; without that, Gatekeeper refuses to open it.
  postflight_steps do
    run "/usr/bin/xattr", args:         ["-dr", "com.apple.quarantine", "{{appdir}}/Claude Profile Switcher.app"],
                          must_succeed: false
  end

  # Gives claude:// links back to Claude if sign-in routing was on, then quits.
  uninstall early_script: {
              executable:   "#{appdir}/Claude Profile Switcher.app/Contents/MacOS/ClaudeProfileSwitcher",
              args:         ["--revert"],
              must_succeed: false,
            },
            quit:         "io.github.onlyilkr.ClaudeProfileSwitcher"

  # Only the switcher's own settings and logs. Extra Claude profiles hold signed-in
  # accounts and chats, so they are never removed by an uninstall.
  zap trash: "~/Library/Application Support/Claude Profile Switcher"
end
